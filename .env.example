# SQLite requires durable disk storage. Prisma resolves this relative to prisma/.
DATABASE_URL="file:./dev.db"
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Central Administrator"
ENABLE_SURVEY_MODULE="false"
NEXT_PUBLIC_ENABLE_SURVEY_MODULE="false"
# Enable only behind a proxy that strips client-supplied forwarding headers.
TRUST_PROXY="false"
# Absolute private directory on a durable volume; defaults to storage/uploads.
UPLOAD_DIR=""
