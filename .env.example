# PostgreSQL: use a pooled URL at runtime and the direct URL for SQL migrations.
DATABASE_URL="postgresql://agri:local-development-only@127.0.0.1:5432/agri_samaj"
DIRECT_URL="postgresql://agri:local-development-only@127.0.0.1:5432/agri_samaj"
# Required on Vercel. Connect a PRIVATE Blob store; never expose this token to the client.
BLOB_READ_WRITE_TOKEN=""
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Central Administrator"
ENABLE_SURVEY_MODULE="false"
NEXT_PUBLIC_ENABLE_SURVEY_MODULE="false"
# Enable only behind a proxy that strips client-supplied forwarding headers.
TRUST_PROXY="false"
# Absolute private directory on a durable volume; defaults to storage/uploads.
UPLOAD_DIR=""
# Optional AI assistant. Server-side only; never prefix these names with NEXT_PUBLIC_.
OPENAI_API_KEY=""
OPENAI_MODEL=""
OPENAI_TRANSCRIPTION_MODEL="gpt-transcribe"
OPENAI_VOICE_MODEL="gpt-realtime-2.1-mini"
# Shared hourly limit across chat, transcription and voice generation.
ASSISTANT_HOURLY_LIMIT="150"
